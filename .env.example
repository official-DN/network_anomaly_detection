# Application
APP_ENV=development
APP_NAME=NetworkAnomalyDetection
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=network_anomaly_db

# Model Paths
MODEL_PATH=./models
DATA_PATH=./data

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Detection
ANOMALY_THRESHOLD=0.5
ISOLATION_CONTAMINATION=0.1
BATCH_SIZE=64
